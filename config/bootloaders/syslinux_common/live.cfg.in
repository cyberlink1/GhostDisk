label ghost-disk-@FLAVOUR@
	menu label Ghost-Disk
	menu default
	linux @LINUX@
	initrd /live/securerd.img
	append @APPEND_LIVE@ initrd2=@INITRD@ kernel2=@LINUX@
label SelfDestruct-@FLAVOUR@
	menu label SelfDestruct
	linux /live/vmlinuz
	initrd /live/initramfs-mini.img
	append init=/init quiet nosgx target=nuke
label SetupData-@FLAVOUR@
	menu label Setup
	linux /live/vmlinuz
	initrd initrd=/live/seurerd.img
	append initrd=/live/securerd.img initrd2=/live/initrd-menu.img kernel2=@LINUX@ init=/init quiet nosgx target=luks
label test-@FLAVOUR@
	menu label Test
	linux /live/vmlinuz
	initrd initrd=/live/securerd.img
	append initrd=/live/securerd.img init=/init quiet nosgx target=shell
