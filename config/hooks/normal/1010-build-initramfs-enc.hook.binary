#!/bin/bash

#
# This is the hook.binary to build the initramfs_enc and include it in the iso
#
HOME_DIR=".."
BINARY_DIR="$(pwd)"

# Load the config
[ -f "$HOME_DIR/make_image.cfg" ] || { echo "Config file not found in $HOME_DIR!"; exit 1; }
. "$HOME_DIR/make_image.cfg"

CHROOT="$HOME_DIR/tmp/chroot"
TEMPLATE_FILE="$HOME_DIR/initramfs_enc.txt"
BUILD_DIR="$HOME_DIR/initramfs_enc"
CUSTOM_SCRIPTS_DIR="$HOME_DIR/custom-scripts"
LOG_PATH="$HOME_DIR/logs"
LISTS_SRC="$HOME_DIR/lists"
LISTS_DST="$HOME_DIR/config/package-lists"


generate_uuid() {
    # Generates a random UUID
    if command -v uuidgen >/dev/null 2>&1; then
        # If uuidgen is installed
        uuidgen | tr '[:lower:]' '[:upper:]'
    elif [ -r /proc/sys/kernel/random/uuid ]; then
        # Fallback for Linux systems
        cat /proc/sys/kernel/random/uuid | tr '[:lower:]' '[:upper:]'
    else
        # Pure bash fallback (less secure, but works)
        echo "$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 8 | head -n 1)-$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 4 | head -n 1)-4$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 3 | head -n 1)-$(printf '%x' $(( (RANDOM % 4) + 8 )))$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 3 | head -n 1)-$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 12 | head -n 1 | tr '[:lower:]' '[:upper:]' )"
    fi
}


build_initramfs() {
    echo "Collecting Kernel Version"
    KVER=$(find "$HOME_DIR/tmp/chroot/lib/modules" -maxdepth 1 -type d -printf "%f\n" \
           | grep -E '^[0-9]' | head -n 1)
#    echo "Generating unique random UUID for partition identification"
#    PART_2_UUID="$(generate_uuid)"
    echo "Creating initramfs_enc"
    rm -rf "$BUILD_DIR" > "$LOG_PATH/build_initramfs-enc.log" 2>&1
    sleep 1
    mkdir -p "$BUILD_DIR" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1

    #
    # change script to handle UUID identification
    # 
    #echo "Updating script with UUID of drive for this build" >> "$LOG_PATH/build_initramfs-enc.log"
    #sed "s/@@UUID@@/$PART_2_UUID/" $HOME_DIR/custom-scripts/functions.sh.template > $HOME_DIR/custom-scripts/functions.sh
    #sed "s/@@UUID@@/$PART_2_UUID/" $HOME_DIR/custom-scripts/luks-detect.sh.template > $HOME_DIR/config/includes.chroot/usr/local/sbin/luks-detect.sh
    #chmod +x $HOME_DIR/config/includes.chroot/usr/local/sbin/luks-detect.sh
   #
   # Build the initramfs-mini from the initramfs-template.txt
   #
    while IFS='|' read -r type path target; do
        [ -z "$path" ] && continue
        path=$(printf "%s" "$path" | sed "s|@KERNEL@|$KVER|g")
        dest="$BUILD_DIR/$path"

        case "$type" in
            d)
                mkdir -p "$dest" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
                ;;
            f)
                mkdir -p "$(dirname "$dest")" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
                cp -L "$HOME_DIR/tmp/chroot/$path" "$dest" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
                ;;
            s)
                mkdir -p "$(dirname "$dest")" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
                cp -L "$CUSTOM_SCRIPTS_DIR/$(basename "$path")" "$dest" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
                ;;
            l)
                mkdir -p "$(dirname "$dest")" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
                ln -s "$target" "$dest" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
                ;;
        esac
    done < "$TEMPLATE_FILE"

    mkdir -p "$BUILD_DIR"/{etc,dev,proc,sys,tmp,mnt,run,sbin} >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
    
    ROOT_HASH=$(openssl passwd -6 "$ROOT_PASSWORD")
    echo "root:$ROOT_HASH:0:0:root:/root:/bin/sh" > "$BUILD_DIR/etc/passwd"
    echo "root:x:0:" > "$BUILD_DIR/etc/group"

    #echo "export TERM=linux" >> "$BUILD_DIR/etc/profile"
    #echo "[ -f /etc/issue ] && cat /etc/issue" >> "$BUILD_DIR/etc/profile"
    #echo "[ -f /etc/motd ] && cat /etc/motd" >> "$BUILD_DIR/etc/profile"

    echo "" > "$BUILD_DIR/etc/fstab"

    chmod +x "$BUILD_DIR/init"
    find "$BUILD_DIR/bin" "$BUILD_DIR/sbin" -type f -exec chmod +x {} \; 2>/dev/null || true >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
    
    echo "Initramfs recreated at $HOME_DIR/initramfs_enc"
    echo "Building initramfs_enc image"
    chroot "$BUILD_DIR" /bin/busybox --install /bin >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
    chroot "$BUILD_DIR" /bin/depmod -b / "$KVER" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
    #
    # Build checksums of /boot
    #
    find . -type f -print0 | xargs -0 sha512sum > "$BUILD_DIR/etc/checksums.txt" 2>/dev/null || true >> "$LOG_PATH/build_initramfs-enc.log" 2>&1


    cd "$BUILD_DIR" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
    find . -print0 | cpio --null -ov --format=newc -V 2>> "$LOG_PATH/build_initramfs-enc.log" | gzip -9 > "$BUILD_DIR/initramfs-enc.img"

    mv "$BUILD_DIR/initramfs-enc.img" "$BINARY_DIR/live/" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1

    cd "$HOME_DIR" >> "$LOG_PATH/build_initramfs-enc.log" 2>&1
    #rm -r "$HOME_DIR/tmp"
}

build_initramfs
