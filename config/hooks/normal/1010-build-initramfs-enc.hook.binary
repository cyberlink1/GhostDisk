#!/bin/bash
set -euo pipefail

#
# This is the hook.binary to build the initramfs_enc and include it in the iso
#
HOME_DIR=".."
BINARY_DIR="$(pwd)"

# Load the config
[ -f "$HOME_DIR/make_image.cfg" ] || { echo "Config file not found in $HOME_DIR!"; exit 1; }
. "$HOME_DIR/make_image.cfg"

CHROOT="$HOME_DIR/tmp/chroot"
TEMPLATE_FILE="$HOME_DIR/securerd/securerd.txt"
BUILD_DIR="$HOME_DIR/securerd-init"
CUSTOM_SCRIPTS_DIR="$HOME_DIR/securerd/custom-scripts"
LOG_PATH="$HOME_DIR/logs"
LISTS_SRC="$HOME_DIR/lists"
LISTS_DST="$HOME_DIR/config/package-lists"


if [ ! -f /tmp/uuid ]; then
    echo "/tmp/uuid not found" >> "$LOG_PATH/build_securerd.log" 2>&1
    exit 1
else
   . /tmp/uuid
fi
generate_uuid() {
    # Generates a random UUID
    if command -v uuidgen >/dev/null 2>&1; then
        # If uuidgen is installed
        uuidgen | tr '[:lower:]' '[:upper:]'
    elif [ -r /proc/sys/kernel/random/uuid ]; then
        # Fallback for Linux systems
        cat /proc/sys/kernel/random/uuid | tr '[:lower:]' '[:upper:]'
    else
        # Pure bash fallback (less secure, but works)
        echo "$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 8 | head -n 1)-$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 4 | head -n 1)-4$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 3 | head -n 1)-$(printf '%x' $(( (RANDOM % 4) + 8 )))$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 3 | head -n 1)-$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 12 | head -n 1 | tr '[:lower:]' '[:upper:]' )"
    fi
}


build_initramfs() {
    echo "Collecting Kernel Version"
    KVER=$(find "$HOME_DIR/tmp/chroot/lib/modules" -maxdepth 1 -type d -printf "%f\n" \
           | grep -E '^[0-9]' | head -n 1)
    echo "Creating initramfs_enc"
    rm -rf "$BUILD_DIR" > "$LOG_PATH/build_securerd.log" 2>&1
    sleep 1
    mkdir -p "$BUILD_DIR" >> "$LOG_PATH/build_securerd.log" 2>&1

   #
   # Build the initramfs-mini from the initramfs-template.txt
   #
    while IFS='|' read -r type path target; do
        [ -z "$path" ] && continue
        path=$(printf "%s" "$path" | sed "s|@KERNEL@|$KVER|g")
        dest="$BUILD_DIR/$path"

        case "$type" in
            d)
                mkdir -p "$dest" >> "$LOG_PATH/build_securerd.log" 2>&1
                ;;
            f)
                mkdir -p "$(dirname "$dest")" >> "$LOG_PATH/build_securerd.log" 2>&1
                cp -L "$HOME_DIR/tmp/chroot/$path" "$dest" >> "$LOG_PATH/build_securerd.log" 2>&1
                ;;
            s)
                mkdir -p "$(dirname "$dest")" >> "$LOG_PATH/build_securerd.log" 2>&1
                cp -L "$CUSTOM_SCRIPTS_DIR/$(basename "$path")" "$dest" >> "$LOG_PATH/build_securerd.log" 2>&1
                ;;
            l)
                mkdir -p "$(dirname "$dest")" >> "$LOG_PATH/build_securerd.log" 2>&1
                ln -s "$target" "$dest" >> "$LOG_PATH/build_securerd.log" 2>&1
                ;;
        esac
    done < "$TEMPLATE_FILE"

    mkdir -p "$BUILD_DIR"/{etc,dev,proc,sys,tmp,mnt,run,sbin} >> "$LOG_PATH/build_securerd.log" 2>&1
    #
    # Create root key that is encrypted with the root password
    #
    mkdir -p "$BUILD_DIR/etc/keys"
    NEW_ROOT_PASS="$(openssl rand -base64 192)"
    echo "$NEW_ROOT_PASS" > "$BUILD_DIR/etc/keys/root-pass"
    if [[ "${CRYPTO,,}" == "openssl" && "${VALIDATION,,}" =~ signature && "${KEY_STORE,,}" =~ keystore ]]; then
	    openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -in "$BUILD_DIR/etc/keys/root-pass" -out "$BUILD_DIR/etc/keys/root-pass.enc" -pass pass:"$ROOT_PASSWORD"
    fi
    if [[ "${CRYPTO,,}" == "pgp" && "${VALIDATION,,}" =~ signature && "${KEY_STORE,,}" =~ keystore ]]; then
      gpg --batch --yes --symmetric --cipher-algo AES256 \
        --passphrase "$ROOT_PASSWORD" \
        --output "$BUILD_DIR/etc/keys/root-pass.enc" \
        "$BUILD_DIR/etc/keys/root-pass" 
    fi
    rm "$BUILD_DIR/etc/keys/root-pass"
    echo "root:x:0:0:root:/root:/bin/sh" > "$BUILD_DIR/etc/passwd"
    echo "root:x:0:" > "$BUILD_DIR/etc/group"

    echo "" > "$BUILD_DIR/etc/fstab"


    find "$BUILD_DIR/bin" "$BUILD_DIR/sbin" -type f -exec chmod +x {} \; 2>/dev/null || true >> "$LOG_PATH/build_securerd.log" 2>&1
    
    echo "Initramfs recreated at $HOME_DIR/initramfs_enc"
    echo "Building initramfs_enc image"
    chroot "$BUILD_DIR" /bin/busybox --install /bin >> "$LOG_PATH/build_securerd.log" 2>&1
    chroot "$BUILD_DIR" rm /bin/cpio >> "$LOG_PATH/build_securerd.log" 2>&1
    chroot "$BUILD_DIR" /bin/depmod -b / "$KVER" >> "$LOG_PATH/build_securerd.log" 2>&1
    #
    # Build checksums of /boot
    #
    #find . -type f \
    #! -name isolinux.bin \
    #-print0 | xargs -0 sha512sum > "$BUILD_DIR/etc/checksums.txt"
    find . -type f \
      ! -name 'isolinux.bin' \
      ! -path './.disk/*' \
      ! -path './isolinux/*' \
      ! -name 'grubx64.efi' \
      ! -name 'efi.img' \
      -print0 | xargs -0 sha512sum > "$BUILD_DIR/etc/checksums.txt"
    #
    # change script to handle UUID identification
    # 
    echo "Updating script with UUID ($PART_2_UUID) of drive for this build" >> "$LOG_PATH/build_securerd.log"

    TEMPLATE="$CUSTOM_SCRIPTS_DIR/init-enc.template"
    OUTPUT="$BUILD_DIR/init"

    # Copy template as starting point
    cp "$TEMPLATE" "$OUTPUT"
    ###################################
    # Helper function to inject a scriptlet
    ###################################
    inject_scriptlet() {
        local placeholder="$1"
        local script_file="$2"
        if [[ ! -f "$script_file" ]]; then
            echo "$script_file is missing" >> "$LOG_PATH/build_securerd.log"
            exit 1
        fi
        awk -v placeholder="$placeholder" -v OUT="$OUTPUT" '
            BEGIN {
                # Read the entire scriptlet file into a single variable, preserving everything raw
                while ((getline line < "'"$script_file"'") > 0) {
                    repl = repl line "\n"
                }
                close("'"$script_file"'")
                # Escape & and \ in the replacement string for gsub
                gsub(/\\/, "\\\\\\\\", repl)
                gsub(/&/, "\\\\&", repl)
            }
            {
                gsub(placeholder, repl)
            }
            1
        ' "$OUTPUT" > "$OUTPUT.tmp" && mv "$OUTPUT.tmp" "$OUTPUT"
    }
    ###################################
    # 1. Replace UUID
    ###################################
    sed -i "s|@@UUID@@|$PART_2_UUID|g" "$OUTPUT"
    ###################################
    # 2. Max failed login attempts
    ###################################
    if [[ -n "$MAX_FAILED" ]]; then
        sed -i "s|@@VAR_MAX_FAIL@@|MAX_FAIL=$MAX_FAILED|g" "$OUTPUT"
        if [[ "$MAX_FAILED" -gt 0 ]]; then
            inject_scriptlet "@@SCRIPT_MAX_FAIL@@" "$CUSTOM_SCRIPTS_DIR/max_failed"
        else
            sed -i "s|@@SCRIPT_MAX_FAIL@@||g" "$OUTPUT"
        fi
    else
        sed -i "s|@@VAR_MAX_FAIL@@||g" "$OUTPUT"
        sed -i "s|@@SCRIPT_MAX_FAIL@@||g" "$OUTPUT"
    fi
    ###################################
    # 3. FAIL_ACTION
    ###################################
    if [[ "${WIPE_ON_FAIL,,}" == "true" ]]; then
        inject_scriptlet "@@FAIL_ACTION@@" "$CUSTOM_SCRIPTS_DIR/wipe_on_fail"
    else
        inject_scriptlet "@@FAIL_ACTION@@" "$CUSTOM_SCRIPTS_DIR/reboot_on_fail"
    fi
    ###################################
    # 4. BOOT authentication
    ###################################
    if [[ "${UNLOCK_BOOT,,}" == "false" ]]; then
        inject_scriptlet "@@BOOT_AUTH@@" "$CUSTOM_SCRIPTS_DIR/boot_noauth"
        inject_scriptlet "@@BOOT_PROMPT@@" "$CUSTOM_SCRIPTS_DIR/boot_noauth"
        inject_scriptlet "@@BOOT_METHOD@@" "$CUSTOM_SCRIPTS_DIR/crypto_noauth"
    else
        inject_scriptlet "@@BOOT_AUTH@@" "$CUSTOM_SCRIPTS_DIR/boot_auth"
 
        case "${KEY_STORE,,}" in
            "keystore")
                inject_scriptlet "@@BOOT_PROMPT@@" "$CUSTOM_SCRIPTS_DIR/boot_keystore"
                if [[ "${CRYPTO,,}" == "openssl" ]]; then
                    cp "$HOME_DIR/openssl/public.pem" "$BUILD_DIR/etc/keys"
                    inject_scriptlet "@@BOOT_METHOD@@" "$CUSTOM_SCRIPTS_DIR/crypt_openssl"
                elif [[ "${CRYPTO,,}" == "pgp" ]]; then
                    cp "$HOME_DIR/gpg/public.asc" "$BUILD_DIR/etc/keys"
                    inject_scriptlet "@@BOOT_METHOD@@" "$CUSTOM_SCRIPTS_DIR/crypt_pgp"
                else
                    inject_scriptlet "@@BOOT_METHOD@@" "$CUSTOM_SCRIPTS_DIR/crypto_noauth"
                fi
                ;;
            "jcop4")
                inject_scriptlet "@@BOOT_PROMPT@@" "$CUSTOM_SCRIPTS_DIR/boot_jcop4"
                inject_scriptlet "@@BOOT_METHOD@@" "$CUSTOM_SCRIPTS_DIR/crypto_jcop4"
                ;;
            "at24c64")
                inject_scriptlet "@@BOOT_PROMPT@@" "$CUSTOM_SCRIPTS_DIR/boot_at24c64"
                inject_scriptlet "@@BOOT_METHOD@@" "$CUSTOM_SCRIPTS_DIR/crypto_AT24C64"
                ;;
            "sle4428")
                inject_scriptlet "@@BOOT_PROMPT@@" "$CUSTOM_SCRIPTS_DIR/boot_sle4428"
                inject_scriptlet "@@BOOT_METHOD@@" "$CUSTOM_SCRIPTS_DIR/crypto_sle4428"
                ;;
            "sle4442")
                inject_scriptlet "@@BOOT_PROMPT@@" "$CUSTOM_SCRIPTS_DIR/boot_sle4442"
                inject_scriptlet "@@BOOT_METHOD@@" "$CUSTOM_SCRIPTS_DIR/crypto_sle4442"
                ;;
            *)
                inject_scriptlet "@@BOOT_PROMPT@@" "$CUSTOM_SCRIPTS_DIR/boot_noauth"
                inject_scriptlet "@@BOOT_METHOD@@" "$CUSTOM_SCRIPTS_DIR/crypto_noauth"
                ;;
        esac
    fi
    ###################################
    # 5. Validation scripts
    ###################################
    IFS='|' read -r -a VALIDATION_ARRAY <<< "$VALIDATION"
    # Convert validation array to lowercase for case-insensitive comparison
    VALIDATION_ARRAY_LOWER=()
    for v in "${VALIDATION_ARRAY[@]}"; do
        VALIDATION_ARRAY_LOWER+=("${v,,}")
    done
  
    declare -A VALIDATION_SCRIPTS=( ["sha512"]="sha512_hash" ["signature"]="signature" )
     
    for key in "${!VALIDATION_SCRIPTS[@]}"; do
        placeholder="@@${key^^}@@"
        found=false
        for v in "${VALIDATION_ARRAY_LOWER[@]}"; do
            if [[ "$v" == "$key" ]]; then
                found=true
                break
            fi
        done
        if [[ "$found" == "true" ]]; then
            # Special handling for signature with keystore
            if [[ "$key" == "signature" ]] && [[ "${KEY_STORE,,}" == "keystore" ]]; then
                if [[ "${CRYPTO,,}" == "openssl" ]]; then
                    inject_scriptlet "$placeholder" "$CUSTOM_SCRIPTS_DIR/signature_openssl"
                elif [[ "${CRYPTO,,}" == "pgp" ]]; then
                    inject_scriptlet "$placeholder" "$CUSTOM_SCRIPTS_DIR/signature_pgp"
                else
                    inject_scriptlet "$placeholder" "$CUSTOM_SCRIPTS_DIR/${VALIDATION_SCRIPTS[$key]}"
                fi
            else
                inject_scriptlet "$placeholder" "$CUSTOM_SCRIPTS_DIR/${VALIDATION_SCRIPTS[$key]}"
            fi
        else
            sed -i "s|$placeholder||g" "$OUTPUT"
        fi
    done
    ###################################
    # 6. Key store helper (if used)
    ###################################
    case "${KEY_STORE,,}" in
        "jcop4")
            inject_scriptlet "@@KEY_STORE@@" "$CUSTOM_SCRIPTS_DIR/key_jcop4"
            ;;
        "at24c64")
            inject_scriptlet "@@KEY_STORE@@" "$CUSTOM_SCRIPTS_DIR/key_at24c64"
            ;;
        "keystore")
            inject_scriptlet "@@KEY_STORE@@" "$CUSTOM_SCRIPTS_DIR/key_store"
            ;;
         *)
           sed -i "s|@@KEY_STORE@@||g" "$OUTPUT"
           ;;
    esac    
    ###################################
    # 7. Cleanup: remove placeholders that are no longer used
    ###################################
    for ph in "@@CRYPTO@@" "@@DECRYPTION@@" "@@WIPE_ON_FAIL@@" "@@VALIDATION@@"; do
         sed -i "s|$ph||g" "$OUTPUT"
    done
   
    echo "Template processed -> $OUTPUT"
    #
    #
    chmod +x "$BUILD_DIR/init"
    cd "$BUILD_DIR" >> "$LOG_PATH/build_securerd.log" 2>&1
    find . -print0 | cpio --null -ov --format=newc -V 2>> "$LOG_PATH/build_securerd.log" | gzip -9 > "$BINARY_DIR/live/securerd.img"


    cd "$HOME_DIR" >> "$LOG_PATH/build_securerd.log" 2>&1
    #rm -r "$HOME_DIR/tmp"
}

build_initramfs
