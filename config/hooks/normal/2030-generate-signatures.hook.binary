#!/bin/bash

#
# This is the hook.binary to generate the signature files in /boot/live
#
HOME_DIR=".."
BINARY_DIR="$(pwd)"

# Load the config
[ -f "$HOME_DIR/make_image.cfg" ] || { echo "Config file not found in $HOME_DIR!"; exit 1; }
. "$HOME_DIR/make_image.cfg"

LOG_PATH="$HOME_DIR/logs"

if [[ "${CRYPTO,,}" = "openssl"  && "${VALIDATION,,}" =~ signature ]]; then
   for file in "$BINARY_DIR/live"/*; do 
        if [ -f "$file" ]; then  # Make sure it's a file, not a directory
            openssl dgst -sha512 -sign "$HOME_DIR/openssl/private.pem" -out "$BINARY_DIR/live/$(basename "$file").sig" "$file"
        fi
       done
fi

if [[ "${CRYPTO,,}" == "pgp" && "${VALIDATION,,}" =~ signature && "${KEY_STORE,,}" == "keystore" ]]; then
	if [ ! -d "$HOME_DIR/gpg_home" ] || [ ! -f "$HOME_DIR/gpg_home/public-key.asc" ]; then
          export GNUPGHOME="$HOME_DIR/gpg"  # ensure the right keyring
          for file in "$BINARY_DIR/live"/*; do 
              if [ -f "$file" ]; then
                  gpg --batch --yes --detach-sign --local-user "user@example.com" \
                      --output "$BINARY_DIR/live/$(basename "$file").sig" "$file"
              fi
         done
        else
	 export GNUPGHOME="$HOME_DIR/gpg_home"

          for file in "$BINARY_DIR/live"/*; do 
              if [ -f "$file" ]; then
                  gpg --batch --yes --detach-sign --output "$BINARY_DIR/live/$(basename "$file").sig" "$file"
              fi
         done
    fi
fi
if [[ "${CRYPTO,,}" == "pgp" && "${VALIDATION,,}" =~ signature && "${KEY_STORE,,}" == "jcop4" ]]; then
	  echo "Generating Signatures"
          export GNUPGHOME="$HOME_DIR/gpg"  # ensure the right keyring
	  CARDINFO="$(gpg --card-status --with-colons)"

	  echo "$CARDINFO"
  	  # Extract the signature key fingerprint (first key on the card)
	  KEYID="$(echo "$CARDINFO" | awk -F: '/^fpr:/ {print $2; exit}')"
          echo "Checking $KEYID"
	  [ -n "$KEYID" ] || exit 2
 
          for file in "$BINARY_DIR/live"/*; do 
                if [ -f "$file" ]; then
		    echo "$file"
                    gpg --batch --yes --detach-sign --local-user "$KEYID" --output "$BINARY_DIR/live/$(basename "$file").sig" "$file"
                fi
         done
fi
