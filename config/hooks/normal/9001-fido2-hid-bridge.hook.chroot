#!/bin/sh
set -e

export DEBIAN_FRONTEND=noninteractive

echo "[+] Installing runtime and build dependencies"

apt-get update
apt-get install -y \
    python3 \
    python3-dev \
    python3-venv \
    python3-poetry \
    pcscd \
    git \
    pipx \
    build-essential \
    libffi-dev \
    libpcsclite-dev

 #    python3-pyscard \
 #
echo "[+] Configuring pipx for system-wide install"

export PIPX_HOME=/opt/pipx
export PIPX_BIN_DIR=/usr/local/bin

mkdir -p "$PIPX_HOME" "$PIPX_BIN_DIR"

echo "[+] Installing fido2-hid-bridge via pipx"

pipx install git+https://github.com/BryanJacobs/fido2-hid-bridge

echo "[+] Installing systemd service"

cat > /etc/systemd/system/fido2-hid-bridge.service <<'EOF'
[Unit]
Description=FIDO2 HID Bridge
After=pcscd.service
Wants=pcscd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/fido2-hid-bridge
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

systemctl enable fido2-hid-bridge.service

echo "[+] Removing build-only packages to reduce image size"

apt-get purge -y \
    python3-dev \
    python3-venv \
    git \
    pipx \
    build-essential || true

apt-get autoremove -y
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "[+] fido2-hid-bridge installation complete"

