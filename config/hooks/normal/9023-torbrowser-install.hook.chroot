#!/bin/bash
set -e

DEST="/opt/tor-browser"
TMP="/tmp/tor-browser.tar.xz"

METADATA_URL="https://aus1.torproject.org/torbrowser/update_3/release/download-linux-x86_64.json"

# Extract latest version from official metadata
TOR_VERSION=$(wget -qO- "$METADATA_URL" \
  | grep -oP '"version"\s*:\s*"\K[^"]+' \
  | head -n 1)

if [ -z "$TOR_VERSION" ]; then
  echo "ERROR: Failed to determine latest Tor Browser version"
  exit 1
fi

TOR_URL="https://www.torproject.org/dist/torbrowser/${TOR_VERSION}/tor-browser-linux-x86_64-${TOR_VERSION}.tar.xz"

echo "Downloading Tor Browser ${TOR_VERSION}"

# Create destination
mkdir -p "$DEST"

# Download and extract
wget -O /tmp/tor-browser.tar.xz "$TOR_URL"
tar -xJf /tmp/tor-browser.tar.xz -C /opt
rm -rf /tmp/tor-browser.tar.xz
chown -R 1000:1000 "$DEST"
