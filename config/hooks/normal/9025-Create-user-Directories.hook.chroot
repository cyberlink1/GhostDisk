#!/bin/bash
set -e

# Loop over every directory in /home
for homedir in /home/*; do
    [ -d "$homedir" ] || continue  # skip if not a directory
    for dir in Documents Downloads Music Pictures Videos Encrypted .gnupg; do
        mkdir -p "$homedir/$dir"
        # Preserve ownership of the parent home directory
        owner=$(stat -c %U "$homedir")
        group=$(stat -c %G "$homedir")
        chown "$owner:$group" "$homedir/$dir"
	if [ $dir == ".gnupg" ]; then
	    echo "disable-ccid" > "$homedir/$dir/scdaemon.conf"
	    echo "pcsc-shared" >> "$homedir/$dir/scdaemon.conf"
	    chmod 700 "$homedir/$dir"
	    chmod 600 "$homedir/$dir/scdaemon.conf"
	    chown "$owner:$group" "$homedir/$dir/scdaemon.conf"
	fi
    done
done
