#############################
# Main menu loop
#############################

while true; do
    MAIN=$(dialog --title "LUKS TUI Main Menu" --menu "Select a category:" 20 60 9 \
        1 "Setup initial persistent storage" \
        2 "LUKS Volume Management" \
        3 "Disk & Partition Tools" \
        4 "Mount / Unmount" \
        5 "Key Management" \
        6 "Repair / Status" \
        7 "Backup & Restore" \
        8 "Shell" \
        9 "Exit" \
        --stdout)

    case "$MAIN" in
        1) /sbin/mkluks ;;
        2) menu_luks_management ;;
        3) menu_disk_tools ;;
        4) menu_mount_tools ;;
        5) menu_key_management ;;
        6) menu_repair_status ;;
        7) menu_backup_restore ;;
        8) run_shell ;;
        9|""|*) break ;;
    esac

done

clear
echo "Exiting LUKS TUI..."

