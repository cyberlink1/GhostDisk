#!/bin/sh
# luks-tui.sh - Full BusyBox/ash-compatible LUKS TUI with submenus, help, and safety features

. /lib/functions.sh
trap cleanup EXIT INT TERM

# BusyBox-safe temporary files
TMP=$(mktemp) || exit 1
register_tmpfile "$TMP"

MAX_ATTEMPTS=3
attempts=0

. /lib/functions.sh

# Ensure dialog is installed
command -v dialog >/dev/null 2>&1 || { echo "dialog not found"; exit 1; }

# extract root hash to detect invalid config
ROOT_HASH=$(awk -F: '/^root:/ {print $2}' /etc/passwd)
	
if [ -z "$ROOT_HASH" ] || [ "$ROOT_HASH" = "!" ]; then
    echo "ERROR: No root password set."
    exit 1
fi

while [ $attempts -lt $MAX_ATTEMPTS ]; do
    # Ask password via dialog
    pass=$(ask_password_once "Enter root password:")
    
    # User cancelled
    [ -z "$pass" ] && {
        dialog --title "Cancelled" --msgbox "Password entry cancelled." 6 50 --stdout
        exit 1
    }

    # Check password (replace pwcheck/pw_hash with your method)
    if pwcheck "$pass" "$ROOT_HASH"; then
        # Correct password → continue script
        break
    fi

    # Incorrect password
    attempts=$((attempts+1))
    dialog --title "Incorrect Password" --msgbox \
        "Password incorrect ($attempts/$MAX_ATTEMPTS)." 6 50 --stdout
done

# Exceeded attempts
if [ $attempts -ge $MAX_ATTEMPTS ]; then
    echo "Too many failed attempts. Nuking..."
    /sbin/nuke
    exit 1
fi

#############################
# Helper functions
#############################

# Generic yes/no confirmation
confirm() {
    dialog --title "$1" --yesno "$2" 8 60
    return $?
}

# Display a help message
show_help() {
    dialog --title "Help: $1" --msgbox "$2" 20 70
}

# Run shell in-place
run_shell() {
    dialog --msgbox "Dropping to shell. Exit to return." 8 50
    /bin/sh
}

# Generic error dialog
err() {
    dialog --title "Error" --msgbox "$1" 8 50
}

#############################
# Submenu functions
#############################
menu_backup_restore() {
    while true; do
        CHOICE=$(dialog --title "Backup & Restore" --menu "Select an option:" 20 70 7 \
            1 "Initialize backup volume" \
            2 "Backup persistent storage" \
            3 "Restore persistent storage" \
            4 "View backup file contents" \
            5 "Restore file" \
            6 "Help" \
            7 "Back" \
            --stdout)

        case "$CHOICE" in
            1) /sbin/menu/initialize_backup_volume ;;
            2) /sbin/menu/backup_persistent_storage ;;
            3) /sbin/menu/restore_persistent_storage ;;
            4) /sbin/menu/view_backup_contents ;;
            5) /sbin/menu/restore_backup_file ;;
            6)
                show_help "Backup & Restore" "\
Initialize backup volume: Lists available LUKS volumes (excluding persistent storage). \
User selects a volume to use as backup; UUID is written to .backup in persistent storage.\n\n\
Backup persistent storage: Mounts persistent storage (RO), reads .backup UUID, mounts target backup device (RW), and creates a tar.gz backup.\n\n\
Restore persistent storage: Mounts persistent storage (RW), reads .backup UUID, mounts backup device (RO), user selects backup file to restore.\n\n\
View backup file contents: Mounts persistent storage and backup device, lists backup files, and lets user view contents.\n\n\
Restore file: Mounts persistent storage and backup device, lets user select a backup file, then select individual files to restore."
                ;;
            7|""|*) break ;;
        esac
    done
}

menu_secure_setup() {
    while true; do
        CHOICE=$(dialog --title "Secure Storage Setup" --menu "Select an option:" 15 60 5 \
            1 "Secure Storage Initialization" \
            2 "Help" \
            3 "Back" \
            --stdout)

        case "$CHOICE" in
            1)
                /sbin/mkluks
                ;;
            2)
                show_help "Secure Storage Setup" "Secure Storage Initialization:\nSets up initial encrypted storage on boot device."
                ;;
            3|""|*) break ;;
        esac
    done
}

