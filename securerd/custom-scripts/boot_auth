#
# This is the boot_auth scriptlet to inject the auth function
#
boot_auth() {
    local fail_count=0
    local boot_pass

    while true; do
        # Call the injected boot prompt function
        boot_pass=$(boot_prompt)

        # Call the injected boot method function
        if boot_method "$boot_pass"; then
            break  # success
        fi

        # Increment fail counter
        fail_count=$((fail_count + 1))
        echo "Authentication failed ($fail_count/$MAX_FAILED)"

        # Call the injected fail action function if max attempts reached
        if [ "$MAX_FAIL" -gt 0 ] && [ "$fail_count" -ge "$MAX_FAIL" ]; then
            unset boot_pass
#            fail_action
        fi

        # Clean up sensitive data
        unset boot_pass
    done
}

boot_auth
