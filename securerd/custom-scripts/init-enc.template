#!/bin/sh
set -e

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run

for m in libata ahci nvme-core nvme scsi_mod sd_mod sg xhci-pci xhci-hcd ehci-pci ehci-hcd ohci-pci ohci-hcd uas mmc_core mmc_block sdhci sdhci-pci usb-storage dm-mod dm-crypt essiv xts mbcache isofs jbd2 ext4 sr_mod cdrom virtio_scsi; do
    modprobe "$m" || true
done

sleep 1
ln -sf /proc/self/fd /dev/fd
ln -sf fd/0 /dev/stdin
ln -sf fd/1 /dev/stdout
ln -sf fd/2 /dev/stderr

PERSISTENT_UUID="@@UUID@@"

mkdir /boot
for disk in /dev/sd* /dev/nvme*n* /dev/mmcblk*; do
    [ -b "$disk" ] || continue
    for part in $(sgdisk -i 1 "$disk" 2>/dev/null; sgdisk -i 2 "$disk" 2>/dev/null); do
        uuid=$(sgdisk -i "${part##* }" "$disk" 2>/dev/null | awk '/Partition GUID/ {print $4}')
        [ "$uuid" = "$PERSISTENT_UUID" ] && BOOT_PART="${disk}1" && mount "$BOOT_PART" /boot && break 2
    done
done

if [ -z "$BOOT_PART" ] && [ -b /dev/sr0 ]; then
    mount -o ro /dev/sr0 /boot
    BOOT_PART="/dev/sr0"
fi


validate_checksums() {
    CHECKSUM_FILE="/etc/checksums.txt"
    [ -f "$CHECKSUM_FILE" ] || exit 1
    echo "Validating boot environment"
    cd /boot
    if sha512sum -c "$CHECKSUM_FILE" > /dev/null; then
        echo "All files passed checksum verification"
    else
        echo "Checksum verification FAILED"
        echo "Press Enter to continue..."
        read dummy
        reboot -f -p
    fi
    cd /
}

validate_checksums


for p in $(cat /proc/cmdline); do
    case $p in
        target=*)  TARGET="${p#target=}" ;;
        kernel2=*) KERNEL2="${p#kernel2=}" ;;
        initrd2=*) INITRD2="${p#initrd2=}" ;;
    esac
done

echo "target: $TARGET"
echo "kernel2: $KERNEL2"
echo "initrd2: $INITRD2"

kexec_switch() {
    [ -n "$KERNEL2" ] && [ -n "$INITRD2" ] || echo "Not set :$KERNEL2:$INITRD2:"
    kexec -l "/boot/$KERNEL2" --initrd="/boot/$INITRD2" --reuse-cmdline
    exec kexec -e
}


case "$TARGET" in
    shell)
        getty -nl /bin/sh 0 /dev/console
        ;;
    *)
        kexec_switch
        ;;
esac

