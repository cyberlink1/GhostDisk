boot_method() {
    local boot_pass="$1"

    # Test decrypt — discard output immediately
    if openssl enc -aes-256-cbc -d -pbkdf2 -iter 200000 \
         -in /etc/keys/root-pass.enc \
         -out /dev/null \
         -pass pass:"$boot_pass" 2>/dev/null; then
        return 0  # Success
    else
        return 1  # Failure
    fi
}
