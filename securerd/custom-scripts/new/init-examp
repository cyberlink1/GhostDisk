#!/bin/sh
set -e
set +m

#
# capture HUP TERM INT and TSTP and properly handle rebooting
#
handle_reboot() {
    echo "Reboot requested, cleaning up..."
    /sbin/wipe_ram
    # optionally do umounts, sync, etc.
    /bin/reboot -f
}
trap handle_reboot HUP TERM INT TSTP


#
# Set vars for init
#
@@VAR_MAX_FAIL@@
PERSISTENT_UUID="@@UUID@@"

# --- injected functions ---
@@BOOT_PROMPT@@
@@BOOT_METHOD@@
@@FAIL_ACTION@@
# -------------------------

#
# mount the filesystems for securerd
#
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run

#
# Load only the kernel modules we need
#
for m in libata ahci nvme-core nvme scsi_mod sd_mod sg xhci-pci xhci-hcd ehci-pci ehci-hcd ohci-pci ohci-hcd uas mmc_core mmc_block sdhci sdhci-pci usb-storage dm-mod dm-crypt essiv xts mbcache isofs jbd2 ext4 sr_mod cdrom virtio_scsi; do
    modprobe "$m" || true
done
sleep 1

#
# Link in some standard devs
#
ln -sf /proc/self/fd /dev/fd
ln -sf fd/0 /dev/stdin
ln -sf fd/1 /dev/stdout
ln -sf fd/2 /dev/stderr

#
# Mount the /boot for access to initrd, securerd, and vmlinuz
#
mkdir /boot
for disk in /dev/sd* /dev/nvme*n* /dev/mmcblk*; do
    [ -b "$disk" ] || continue
    for part in $(sgdisk -i 1 "$disk" 2>/dev/null; sgdisk -i 2 "$disk" 2>/dev/null); do
        uuid=$(sgdisk -i "${part##* }" "$disk" 2>/dev/null | awk '/Partition GUID/ {print $4}')
        [ "$uuid" = "$PERSISTENT_UUID" ] && BOOT_PART="${disk}1" && mount "$BOOT_PART" /boot && break 2
    done
done
#
# If the above fails we default to /dev/sr0
# needed for proxmox qemu vm's that id the iso
# as being on /dev/sr0
#
if [ -z "$BOOT_PART" ] && [ -b /dev/sr0 ]; then
    mount -o ro /dev/sr0 /boot
    BOOT_PART="/dev/sr0"
fi

@@SHA512@@

#
# Check the command line and pull in
# target, kernel2, and initrd2
#
for p in $(cat /proc/cmdline); do
    case $p in
        target=*)  TARGET="${p#target=}" ;;
        kernel2=*) KERNEL2="${p#kernel2=}" ;;
        initrd2=*) INITRD2="${p#initrd2=}" ;;
    esac
done

@@SIGNATURE@@
@@BOOT_AUTH@@

#
# Function to kexec switch to the initrd2 and kernel2 to continue the boot
# process after checks
#
kexec_switch() {
    [ -n "$KERNEL2" ] && [ -n "$INITRD2" ] || echo "Not set :$KERNEL2:$INITRD2:"
    kexec -l "/boot/$KERNEL2" --initrd="/boot/$INITRD2" --reuse-cmdline
    /sbin/wipe_ram
    exec kexec -e
}

#
# handle target for shell access (testing only)
#
case "$TARGET" in
    shell)
        getty -nl /bin/sh 0 /dev/console
	handle_reboot
        ;;
   reboot)
	reboot
	;;
    *)
        kexec_switch
        ;;
esac

