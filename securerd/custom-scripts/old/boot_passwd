#
# Prompt for boot password and verify by attempting decryption
#

fail_count=0

while true; do
    echo -n "Enter Boot Password: "
    stty -echo
    read -r BOOT_PASS
    stty echo
    echo

    # Test decrypt — discard output immediately
    if openssl enc -aes-256-cbc -d -pbkdf2 -iter 200000 \
         -in /etc/keys/root-pass.enc \
         -out /dev/null \
         -pass pass:"$BOOT_PASS" 2>/dev/null; then
        break  # Success!
    fi

    # Failed decrypt
    fail_count=$((fail_count + 1))
    echo "Invalid password ($fail_count/$MAX_FAILED)"

    if [ "$fail_count" -ge "$MAX_FAILED" ]; then
        if [ "$WIPE_ON_FAIL" = "true" ]; then
            echo "Maximum attempts reached — wiping persistent storage!"
            #wipe_on_fail
        fi
        echo "Maximum attempts reached — powering off!"
        handle_reboot
    fi
done

# Remove sensitive data from memory
unset BOOT_PASS

