#!/bin/sh
# smartcard-auth.sh: Unlock initrd with JCOP4 card
# 
# pkcs15-tool --read-public-key authkey --output card_auth_pub.pem
#
# pkcs15-tool --dump
#     Public Key [Authentication]
#     ...
#     ID: ##
# pkcs15-tool --read-public-key 01 --output card_auth_pub.pem
# Verify the public key file
# openssl pkey -in card_auth_pub.pem -pubin -text -noout
# 

READER=0
PUBKEY="/etc/card_auth_pub.pem"

# Generate 8 or 32 byte host challenge
CHAL=$(openssl rand -hex 32)

# Convert to APDU for authentication key (9A)
APDU="00 87 00 9A 20 $CHAL"

# Send APDU to card and get response
RESP=$(opensc-tool -r $READER -a "$APDU" | awk '/Response/ {print $2}')

# Convert to binary
echo "$CHAL" | xxd -r -p > /tmp/chal.bin
echo "$RESP" | xxd -r -p > /tmp/sig.bin

# Verify signature with public key
if openssl dgst -sha256 -verify "$PUBKEY" -signature /tmp/sig.bin /tmp/chal.bin; then
    echo "OpenPGP card authentication PASSED"
    exit 0
else
    echo "Authentication FAILED"
    exit 1
fi

