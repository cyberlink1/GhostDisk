#
# Verify the signature on a file in /boot
#
verify_signature() {
    f="$1"
    sig="/boot/live/$(basename "$f").sig"
    key="/etc/keys/public.pem"

    [ -f "$sig" ] || return 1

    
    { openssl dgst -sha512 -verify "$key" -signature "$sig" "$f"; } >/dev/null 
    return $?
}

echo "Checking signature on securerd.img"
verify_signature "/boot/live/securerd.img" || fail "I can not be trusted!"

if [ -n "$INITRD2" ]; then
    echo -n "Checking signature on initrd and vmlimuz"
    verify_signature "/boot/$INITRD2" || fail "Initrd Failed signature check"
    echo "...Pass"
fi

if [ -n "$KERNEL2" ]; then
    echo -n "Checking signature vmlimuz"
    verify_signature "/boot/$KERNEL2" || fail "Kernel Failed signature check"
    echo "...Pass"
fi

echo "Signatures passed"
