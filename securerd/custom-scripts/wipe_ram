#!/bin/sh
# wipe_ram.sh : Secure memory scrub before kexec
# Requires: busybox, /proc/sys/vm/*

echo "Scrubbing memory before kexec..."

# 1 Overwrite shell environment variables (passwords often end up here)
for var in $(env | cut -d= -f1); do
    unset "$var"
done

# 2 Drop page cache, dentries, and inodes
# Ensures secrets aren't hanging around in buffer cache
/bin/sync
echo 3 > /proc/sys/vm/drop_caches || true


# 3 Allocate as much RAM as possible and overwrite it with zeros
mem_kb=$(/bin/awk '/MemAvailable/ {print $2}' /proc/meminfo 2>/dev/null)
[ -z "$mem_kb" ] && mem_kb=$(awk '/MemFree/ {print $2}' /proc/meminfo)
wipe_kb=$((mem_kb * 90 / 100))

echo "Wiping ${wipe_kb}KB of RAM..."
dd if=/dev/zero of=/dev/ram0 bs=1K count="$wipe_kb" 2>/dev/null || true

# Optionally, wipe kernel memory
# dd if=/dev/zero of=/dev/mem bs=1M status=progress || true

/bin/sync

# 4 Force freeing buffers we just filled
echo 3 > /proc/sys/vm/drop_caches || true

echo "RAM scrub complete."

